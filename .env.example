# Copy to .env  (cp .env.example .env). NEVER commit .env.
# --- LLM (optional: without it the agent uses its deterministic rule-based planner) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# AGENT_MODE=rules   # force rule-based mode even when a key is present

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=mlops-agent-demo

# --- Airflow 3 (dev credentials from docker-compose) ---
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_TRAINING_DAG=training_pipeline
AIRFLOW_APPROVED_DAGS=training_pipeline

# --- Kubernetes (the ONLY namespace the agent may touch) ---
K8S_NAMESPACE=mlops-agent
K8S_APP_LABEL=ml-inference
K8S_DEPLOYMENT=ml-inference-api
K8S_CONFIGMAP=ml-inference-config

# --- Policies used when recommending retraining ---
MIN_F1=0.85
# FRESHNESS_DAYS=30   # leave unset = no freshness policy defined

# --- Misc ---
TOOL_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
# LOG_FILE=agent.log
